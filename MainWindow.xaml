<Window x:Class="DiskExplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DiskExplorer"
        Title="HC Disk Gezgini - Klasör Boyutları ve Dosya Listesi - 2026 Version 1.0"
        Icon="app.ico"
        Height="760" Width="1400" MinHeight="450" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">

    <Window.Resources>

        <!-- ===== Liste satır renkleri (değiştirmek için sadece buradaki kodları düzenleyin) ===== -->
        <SolidColorBrush x:Key="DirRowBrush"  Color="#FFF6B8"/>   <!-- Dizinler : Sarı -->
        <SolidColorBrush x:Key="AppRowBrush"  Color="#BCD9FB"/>   <!-- Uygulamalar : Mavi -->
        <SolidColorBrush x:Key="DllRowBrush"  Color="#D9C2F2"/>   <!-- DLL dosyaları : Mor -->


        <!-- ===== Ağaçtaki "+" / "-" aç-kapa butonu ===== -->
        <Style x:Key="ExpanderToggleStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Width="18" Height="20">
                            <Border Width="11" Height="11" BorderBrush="#FF808080" BorderThickness="1"
                                    Background="White" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="Sign" Text="+" Foreground="Black" FontSize="10" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Sign" Property="Text" Value="-"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Düz (flat) ProgressBar: klasörün üst klasördeki payını arka planda gösterir ===== -->
        <Style x:Key="ShareBarStyle" TargetType="ProgressBar">
            <Setter Property="Foreground" Value="#FFBBD7F2"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border x:Name="PART_Track" Background="Transparent">
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            ===== TreeViewItem şablonu =====
            Başlık alanı (Header) satırın tamamına yayılır; böylece Boyut ve Dosya sayısı
            sütunları ağacın sağ kenarında hizalı kalır. Her kademe 18 piksel içeriden başlar.
        -->
        <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="2,1"/>
            <EventSetter Event="Selected" Handler="TreeItem_Selected"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ToggleButton x:Name="Expander" Style="{StaticResource ExpanderToggleStyle}"
                                          IsChecked="{Binding Path=IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"/>

                            <Border x:Name="Bd" Grid.Column="1"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter x:Name="PART_Header" ContentSource="Header"
                                                  HorizontalAlignment="Stretch"/>
                            </Border>

                            <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{x:Static SystemColors.HighlightBrush}"/>
                                <Setter Property="Foreground" Value="{x:Static SystemColors.HighlightTextBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="Selector.IsSelectionActive" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{x:Static SystemColors.InactiveSelectionHighlightBrush}"/>
                                <Setter Property="Foreground" Value="{x:Static SystemColors.ControlTextBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Ağaç düğümünün görünümü:  [ikon] Ad ........ Boyut - N File ===== -->
        <HierarchicalDataTemplate DataType="{x:Type local:DirNode}" ItemsSource="{Binding Children}">
            <Grid Height="22" ToolTip="{Binding FullPath}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="115"/>
                </Grid.ColumnDefinitions>

                <!-- Arka plandaki pay çubuğu -->
                <ProgressBar Grid.ColumnSpan="3" Style="{StaticResource ShareBarStyle}"
                             Value="{Binding Percent, Mode=OneWay}"/>

                <DockPanel Grid.Column="0" VerticalAlignment="Center" LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Icon}" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <TextBlock Grid.Column="1" Text="{Binding SizeText}" TextAlignment="Right"
                           VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="2" Text="{Binding FilesText}" TextAlignment="Right"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
            </Grid>
        </HierarchicalDataTemplate>

    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= ÜST: SÜRÜCÜ SEÇİMİ ================= -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="Sürücüler (birden fazla seçebilirsiniz)">
                <ItemsControl x:Name="DriveList" ItemsSource="{Binding Drives}" Margin="2">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Margin="4,3,18,3"
                                      IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                      Content="{Binding Display}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </GroupBox>

            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                <Button x:Name="BtnScan" Content="▶ Taramayı Başlat" Width="170" Height="30"
                        Margin="0,0,0,6" Click="BtnScan_Click"/>
                <Button x:Name="BtnRefresh" Content="⟳ Sürücüleri Yenile" Width="170" Height="26"
                        Click="BtnRefresh_Click"/>
            </StackPanel>
        </Grid>

        <!-- ================= ORTA: SOL AĞAÇ | SAĞ LİSTE ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="460" MinWidth="250"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- SOL: Klasör ağacı -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Klasör Ağacı  (boyuta göre sıralı)"
                           FontWeight="Bold" Margin="2,0,0,4"/>
                <TreeView x:Name="TreeFolders"
                          ItemsSource="{Binding Roots}"
                          SelectedItemChanged="TreeFolders_SelectedItemChanged"
                          PreviewMouseRightButtonDown="Tree_PreviewRightClick"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Standard">
                    <TreeView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Explorer'da Aç" Click="TreeMenuOpen_Click"/>
                            <MenuItem Header="Yolu Kopyala" Click="TreeMenuCopy_Click"/>
                        </ContextMenu>
                    </TreeView.ContextMenu>
                </TreeView>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#FFE0E0E0"/>

            <!-- SAĞ: Dosya / klasör listesi -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtPath" FontWeight="Bold" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Text="Bir klasör seçin"/>
                    <CheckBox x:Name="ChkRecursive" Grid.Column="1" VerticalAlignment="Center"
                              Content="Alt klasörlerdeki dosyaları da listele"
                              Checked="ChkRecursive_Changed" Unchecked="ChkRecursive_Changed"/>
                </Grid>

                <ListView x:Name="ListFiles" Grid.Row="1"
                          SelectionMode="Extended"
                          GridViewColumnHeader.Click="ListHeader_Click"
                          MouseDoubleClick="ListFiles_MouseDoubleClick"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Style.Triggers>
                                <!-- Seçili satırın mavi vurgusu şablondan geldiği için seçimde de çalışmaya devam eder -->
                                <DataTrigger Binding="{Binding Category}" Value="Dir">
                                    <Setter Property="Background" Value="{StaticResource DirRowBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Category}" Value="App">
                                    <Setter Property="Background" Value="{StaticResource AppRowBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Category}" Value="Dll">
                                    <Setter Property="Background" Value="{StaticResource DllRowBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Aç" Click="ListMenuOpen_Click"/>
                            <MenuItem Header="Explorer'da Göster" Click="ListMenuShow_Click"/>
                            <MenuItem Header="Yolu Kopyala" Click="ListMenuCopy_Click"/>
                        </ContextMenu>
                    </ListView.ContextMenu>

                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="File Name" Width="280">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <DockPanel LastChildFill="True">
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Icon}" Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="Extension" Width="80"
                                            DisplayMemberBinding="{Binding Extension}"/>

                            <GridViewColumn Header="Size" Width="95">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SizeText}" TextAlignment="Right"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="Create Date" Width="135"
                                            DisplayMemberBinding="{Binding Created, StringFormat={}{0:dd.MM.yyyy HH:mm:ss}}"/>
                            <GridViewColumn Header="Last Date" Width="135"
                                            DisplayMemberBinding="{Binding Modified, StringFormat={}{0:dd.MM.yyyy HH:mm:ss}}"/>
                            <GridViewColumn Header="Last Access" Width="135"
                                            DisplayMemberBinding="{Binding Accessed, StringFormat={}{0:dd.MM.yyyy HH:mm:ss}}"/>
                            <GridViewColumn Header="Mime Type" Width="190"
                                            DisplayMemberBinding="{Binding MimeType}"/>
                            <GridViewColumn Header="Attributes" Width="70"
                                            DisplayMemberBinding="{Binding Attributes}"/>
                            <GridViewColumn Header="Full Path" Width="450"
                                            DisplayMemberBinding="{Binding FullPath}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Grid>

        <!-- ================= ALT: DURUM ÇUBUĞU ================= -->
        <StatusBar Grid.Row="2" Margin="0,6,0,0">
            <StatusBarItem>
                <ProgressBar x:Name="PrgScan" Width="130" Height="12" IsIndeterminate="True"
                             Visibility="Collapsed"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock x:Name="TxtStatus" Text="Sürücüleri seçip taramayı başlatın."/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="TxtListStatus" Text=""/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
